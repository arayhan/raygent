{
  "name": "raygent",
  "version": "0.1.0",
  "description": "Personal CLI for managing Claude Code agent skills and project scaffolding",
  "type": "module",
  "bin": {
    "raygent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "dist-web",
    "vendor"
  ],
  "scripts": {
    "build": "node scripts/bundle-scaffolder.mjs && tsc -p tsconfig.json && vite build --config dashboard-web/vite.config.ts",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "dev:web": "vite --config dashboard-web/vite.config.ts",
    "typecheck:web": "tsc -p dashboard-web/tsconfig.json",
    "prepublishOnly": "npm test && npm run build",
    "bundle:scaffolder": "node scripts/bundle-scaffolder.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "@inquirer/prompts": "^7.0.0",
    "commander": "^12.1.0",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.21",
    "vitest": "^2.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
